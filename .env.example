# Local development defaults (SQLite + local Ollama).
# Docker Compose overrides DB/Ollama URLs for the container network.

APP_NAME=Hybrid-Search Enterprise Document Q&A
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

API_KEYS=dev-secret-key-change-me

MAX_TEXT_LENGTH=100000
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Local light mode
DATABASE_URL=sqlite+aiosqlite:///./data/hybrid_rag.db
# Docker / Postgres:
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/hybrid_rag

LLM_PROVIDER=auto
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=800
CHUNK_OVERLAP=120

HYBRID_VECTOR_WEIGHT=0.55
HYBRID_FTS_WEIGHT=0.45
HYBRID_CANDIDATE_LIMIT=20
RERANK_TOP_K=3
MIN_CONFIDENCE_THRESHOLD=0.35

RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

UPLOAD_DIR=./uploads
